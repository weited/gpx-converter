{
  "name": "gpx-converter",
  "version": "1.0.0",
  "description": "Convert KML and CSV files to GPX — CLI and web app",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "to-gpx": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "gpx",
    "kml",
    "csv",
    "gps",
    "converter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
